# =============================================================================
# Vendorly mobile (Expo) environment
# For EAS builds, prefer `eas secret:create` over committing real values.
# Copy to mobile/.env and fill required keys (empty strings until set).
# =============================================================================

# --- Required client runtime ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional unprefixed aliases for shared tooling
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Set to true only for local typecheck/tests that must skip Zod env guardrails
ENV_VALIDATION_SKIP=

# Optional: hosted web app URL for deep links and marketing redirects.
EXPO_PUBLIC_APP_URL=

# Hosted HTTPS bridge for email links (required for reliable reset/confirm on device).
EXPO_PUBLIC_AUTH_REDIRECT_URL=

# Legal pages (required for App Store)
EXPO_PUBLIC_LEGAL_TERMS_URL=
EXPO_PUBLIC_LEGAL_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_URL=

# Optional Nest API URL for POS/vendor backend features.
# Shopper flows work without it. Omit for Supabase-only production builds.
EXPO_PUBLIC_API_URL=

# OAuth redirect: vendorly://auth/callback — add in Supabase Auth → URL Configuration.
