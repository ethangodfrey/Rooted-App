{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --prefix ../packages/env-config && npm install",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "rewrites": [],
  "headers": [
    {
      "source": "/api/health/readiness",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
