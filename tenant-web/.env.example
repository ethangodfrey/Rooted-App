# =============================================================================
# Tenant-web (Next.js edge multi-tenant gateway)
# Deploy as a separate Vercel project rooted at tenant-web/
# Copy to tenant-web/.env.local and fill required keys (empty until set).
# =============================================================================

# --- Required client/server runtime (validated by @vendorly/env-config) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Set to true only for local typecheck/tests that must skip Zod env guardrails
ENV_VALIDATION_SKIP=

# Platform apex domain used for {slug}.vendorlymarketplace.com subdomain routing
TENANT_PLATFORM_DOMAIN=vendorlymarketplace.com

# Backend tenant resolve API (NestJS)
TENANT_API_URL=
# Shared secret for background revalidation (optional in dev)
TENANT_REVALIDATE_SECRET=

# Upstash Redis REST credentials (edge-safe; same store as backend tenant cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash Redis TCP URL (BullMQ ingest queue — same as backend REDIS_URL)
REDIS_URL=

# Square inventory webhook signature verification
SQUARE_WEBHOOK_SIGNATURE_KEY=
POS_INVENTORY_WEBHOOK_URL=
POS_SALES_WEBHOOK_URL=
SQUARE_SALES_WEBHOOK_SIGNATURE_KEY=
POS_SALES_WEBHOOK_TEST_MODE=
POS_WEBHOOK_TEST_SECRET=

# Toast inventory webhook HMAC secret
TOAST_WEBHOOK_SECRET=

# OAuth state signing for /api/auth/square + /api/integration/connect (min 32 chars)
POS_OAUTH_STATE_SECRET=
INTEGRATION_OAUTH_BASE_URL=
INTEGRATION_CORS_ORIGINS=http://localhost:5173,https://vendorlymarketplace.com,https://www.vendorlymarketplace.com,https://vendorly-marketplace1.vercel.app
POS_CREDENTIAL_KEY=

# Square OAuth
SQUARE_ENVIRONMENT=
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=

# Clover OAuth
CLOVER_ENVIRONMENT=
CLOVER_APP_ID=
CLOVER_APP_SECRET=

# Service-role key for vendor_pos_connections upsert (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
