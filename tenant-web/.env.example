# Tenant-web (Next.js edge multi-tenant gateway)
# Deploy as a separate Vercel project rooted at tenant-web/

# Platform apex domain used for {slug}.rooted.app subdomain routing
TENANT_PLATFORM_DOMAIN=rooted.app

# Backend tenant resolve API (NestJS)
TENANT_API_URL=http://localhost:4000
# Shared secret for background revalidation (optional in dev)
TENANT_REVALIDATE_SECRET=

# Upstash Redis REST credentials (edge-safe; same store as backend tenant cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash Redis TCP URL (BullMQ ingest queue — same as backend REDIS_URL)
REDIS_URL=

# Square inventory webhook signature verification (Inventory/Stock subscription)
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Public URL registered with Square for THIS route (must match byte-for-byte)
POS_INVENTORY_WEBHOOK_URL=https://your-tenant-gateway.vercel.app/api/webhooks/pos-sync
# Sales ledger webhook (Phase B) — register separately in Square Developer Dashboard
POS_SALES_WEBHOOK_URL=https://your-tenant-gateway.vercel.app/api/webhooks/pos-sales
# Signature key from the *sales* Square subscription (different from inventory key)
SQUARE_SALES_WEBHOOK_SIGNATURE_KEY=
# Dev/staging only — HMAC bypass for scripts/test-pos-sales-webhook.ts
# Never enable in production without POS_WEBHOOK_TEST_SECRET rotated regularly.
POS_SALES_WEBHOOK_TEST_MODE=false
POS_WEBHOOK_TEST_SECRET=

# Toast inventory webhook HMAC secret
TOAST_WEBHOOK_SECRET=

# OAuth state signing for /api/auth/square + /api/integration/connect (min 32 chars)
POS_OAUTH_STATE_SECRET=
# Public tenant-web origin for OAuth redirect_uri (NOT connect.squareup.com)
INTEGRATION_OAUTH_BASE_URL=https://tenant-web-psi.vercel.app
# Comma-separated Vite SPA origins allowed to call OAuth connect with Bearer
INTEGRATION_CORS_ORIGINS=http://localhost:5173,https://vendorly.app,https://vendorlymarketplace.vercel.app,https://vendorly-marketplace1.vercel.app
# AES-256-GCM key (32-byte base64) — must match Nest POS_CREDENTIAL_KEY
POS_CREDENTIAL_KEY=

# Square OAuth (prefer /api/auth/square + /api/auth/callback/square)
# Register redirect: {INTEGRATION_OAUTH_BASE_URL}/api/auth/callback/square
SQUARE_ENVIRONMENT=production
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=

# Clover OAuth
CLOVER_ENVIRONMENT=sandbox
CLOVER_APP_ID=
CLOVER_APP_SECRET=

# Service-role key for vendor_pos_connections upsert (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (explore feed API — GET /api/explore/feed)
SUPABASE_URL=
SUPABASE_ANON_KEY=
