{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci --prefix packages/env-config && npm run build --prefix packages/env-config && npm ci --prefix tenant-web && npm run build --prefix tenant-web",
    "watchPatterns": [
      "tenant-web/**",
      "packages/env-config/**",
      "deploy/ingress.targets.json",
      "tenant-web/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run start --prefix tenant-web",
    "healthcheckPath": "/api/health/readiness",
    "healthcheckTimeout": 100,
    "overlapSeconds": 20,
    "drainingSeconds": 10,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "environments": {
    "production": {
      "variables": {
        "PORT": "3000"
      },
      "deploy": {
        "startCommand": "npm run start --prefix tenant-web",
        "healthcheckPath": "/api/health/readiness",
        "healthcheckTimeout": 120,
        "overlapSeconds": 30,
        "drainingSeconds": 15,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    }
  }
}
