# =============================================================================
# Vendorly root tooling environment
# Copy to .env and fill required keys. Use empty strings until values are set.
# =============================================================================

# --- Required runtime (server tooling / CI simulation) ---
# Postgres connection string (postgres:// or postgresql://)
DATABASE_URL=
# Supabase project URL (https://...)
SUPABASE_URL=
# Supabase anon/public key (long JWT-like token)
SUPABASE_ANON_KEY=

# Optional aliases consumed by web / scripts
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
NEST_API_URL=
API_URL=

# Set to true only for local typecheck/tests that must skip Zod env guardrails
ENV_VALIDATION_SKIP=

# --- USDA market seed ---
# Request at: https://www.usdalocalfoodportal.com/fe/datasharing/
USDA_API_KEY=

# --- Webhook load test (npm run test:webhook) ---
POS_WEBHOOK_TEST_URL=
POS_INVENTORY_WEBHOOK_URL=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# --- Checkout pipeline test (npm run test:checkout) ---
CHECKOUT_TEST_URL=
CHECKOUT_TEST_LOCAL_URL=
CHECKOUT_TEST_ACCESS_TOKEN=
CHECKOUT_TEST_EMAIL=
CHECKOUT_TEST_PASSWORD=
