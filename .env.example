# USDA Local Food Directories API key (farmers market seed script)
# Request at: https://www.usdalocalfoodportal.com/fe/datasharing/
# Copy this file to .env and paste your key:
#
#   cp .env.example .env   (Mac/Linux/WSL)
#   copy .env.example .env (Windows)

USDA_API_KEY=your_usda_api_key_here

# Webhook load test (npm run test:webhook)
POS_WEBHOOK_TEST_URL=https://rooted-app-mu.vercel.app/api/webhooks/pos-sync?provider=SQUARE
POS_INVENTORY_WEBHOOK_URL=https://rooted-app-mu.vercel.app/api/webhooks/pos-sync
SQUARE_WEBHOOK_SIGNATURE_KEY=load-test-signing-key

# Checkout pipeline test (npm run test:checkout)
CHECKOUT_TEST_URL=https://rooted-app-mu.vercel.app/api/checkout/initiate
# Local tenant-web fallback when production route is not yet deployed:
CHECKOUT_TEST_LOCAL_URL=http://localhost:3000/api/checkout/initiate
# CHECKOUT_TEST_ACCESS_TOKEN=
# CHECKOUT_TEST_EMAIL=
# CHECKOUT_TEST_PASSWORD=
