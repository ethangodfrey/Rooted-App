{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["scripts/**/*.ts"],
  "exclude": [
    "node_modules",
    "web",
    "mobile",
    "backend",
    "data",
    "docs",
    "scripts/autonomous-health-check.ts",
    "scripts/e2e-phase-c-pipeline.ts",
    "scripts/seed-markets.ts",
    "scripts/test-checkout-pipeline.ts"
  ]
}
