# =============================================================================
# Vendorly web (Vite) environment
# Copy to web/.env and fill required keys. Use empty strings until values are set.
# =============================================================================

# --- Required client runtime (aliases for @vendorly/env-config validateClientEnv) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional unprefixed aliases (scripts / shared tooling)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Set to true only for local typecheck/tests that must skip Zod env guardrails
ENV_VALIDATION_SKIP=

# Public site URL for email confirm / password reset / OAuth links.
# Dev: leave unset — the app uses window.location.origin automatically.
VITE_APP_URL=

# Vite API (NestJS backend)
# Local: http://localhost:4000
# Production: https://api.vendorlymarketplace.app (or Railway HTTPS host)
VITE_API_URL=

# Tenant edge gateway (separate Vercel project — NOT bundled into web build)
VITE_TENANT_WEB_URL=
VITE_MARKETS_API_URL=

# --- Notes ---
# Market/event listings load from Supabase (events table + search_all RPC).
# Google/Apple OAuth: enable providers in Supabase Dashboard + add redirect URLs.
# See docs/OFF_LAN_ACCESS.md and docs/DEPLOY.md.
