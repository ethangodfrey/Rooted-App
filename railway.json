{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile",
    "watchPatterns": [
      "backend/**",
      "packages/env-config/**",
      ".dockerignore",
      "deploy/ingress.targets.json",
      "railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "overlapSeconds": 30,
    "drainingSeconds": 15,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "environments": {
    "production": {
      "variables": {
        "PORT": "4000",
        "PUBLIC_BASE_URL": "https://api.vendorlymarketplace.app"
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "backend/Dockerfile",
        "watchPatterns": [
          "backend/**",
          "packages/env-config/**",
          ".dockerignore",
          "deploy/ingress.targets.json",
          "railway.json"
        ]
      },
      "deploy": {
        "healthcheckPath": "/api/health",
        "healthcheckTimeout": 120,
        "overlapSeconds": 45,
        "drainingSeconds": 30,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    }
  }
}
