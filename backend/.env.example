# ---------------------------------------------------------------------------
# Vendorly backend environment
# Copy to backend/.env and fill required keys (empty strings until set).
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Nationwide geo nearby EXPLAIN profiling (GEO_INDEX_MATCHED / TABLE_SCAN_AVOIDED).
# Default: on when NODE_ENV≠production. Set 0/false to disable; 1/true to force on.
GEO_QUERY_PROFILE=

# Set to true only for Jest / local typecheck that must skip Zod env guardrails
ENV_VALIDATION_SKIP=

# --- Required runtime (validated by @vendorly/env-config) ---
# Postgres (postgres:// or postgresql://). Prefer Supabase transaction pooler :6543.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional examples (do not commit real values):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Never use db.*.supabase.co:6543 (pooler port on the wrong host).
# Railway: set DATABASE_URL to the transaction pooler string. DIRECT_URL optional unless migrating from Railway.

# Redis for BullMQ (sync + aggregation job queues).
# Upstash (easiest): Connect → TCP tab → copy the full REDIS_URL (rediss://...).
REDIS_URL=
# Local dev: leave POS_QUEUES_ENABLED=false (default when NODE_ENV≠production).
# POS sync/aggregation still work inline — no Redis workers needed.
# Set true only when you have Redis headroom (production or local Redis).
POS_QUEUES_ENABLED=false
# Or discrete vars for local Redis:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# 32-byte key (base64) used for AES-256-GCM credential encryption at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
POS_CREDENTIAL_KEY=

# POS inventory webhook ingest (Next.js tenant-web route)
# Register POS_INVENTORY_WEBHOOK_URL with Square/Toast → tenant-web /api/webhooks/pos-sync
POS_INVENTORY_WEBHOOK_URL=

# Analytics webhook engine (historical_sales_metrics + stock decrement)
# POST /webhooks/pos/square|toast  — header x-vendorly-webhook-token
# Defaults to DEMO_WEBHOOK_TOKEN when unset (local/dev only).
POS_ANALYTICS_WEBHOOK_SECRET=
SQUARE_WEBHOOK_SECRET=
TOAST_WEBHOOK_SECRET=

# Multi-tenant marketplace routing (custom domains + platform subdomains)
TENANT_PLATFORM_DOMAIN=rooted.app

# Public base URL of this backend (must be the LIVE Railway HTTPS host).
# Current production:
PUBLIC_BASE_URL=https://rooted-app-production-43fb.up.railway.app
# Optional override for provider OAuth/webhooks (defaults to PUBLIC_BASE_URL):
# POS_PROVIDER_BASE_URL=https://rooted-app-production-43fb.up.railway.app

# Web app origin for CORS (Vite dev / production site). Comma-separate for multiple.
# Production / off-LAN: set to your Vercel or custom domain (required for browser API calls).
WEB_APP_URL=http://localhost:5173
# CORS_ORIGINS=https://vendorlymarketplace.com,https://www.vendorlymarketplace.com,https://your-project.vercel.app
# HTTPS *.vendorlymarketplace.com / *.vendorlymarketplace.app (legacy *.vendorly.app still trusted) subdomains are auto-allowed in production (see common/cors/origin-policy.ts).
# In dev, private LAN IPs (10.x, 192.168.x) are allowed automatically.

# HTTPS URL for POS provider OAuth redirects + webhooks. Required for Square (HTTPS only).
# Local dev: run `ngrok http 4000` and paste the https:// URL here. Mobile can still use
# a LAN IP via EXPO_PUBLIC_API_URL. See docs/SQUARE_SETUP.md.
POS_PROVIDER_BASE_URL=

# Deep link the OAuth callback bounces back to after connecting.
# Must match the mobile app scheme (app.json "scheme": "vendorly"). In Expo Go dev,
# set this to the printed exp:// URL + /pos/connected instead.
APP_DEEP_LINK=vendorly://pos/connected

# Supabase auth extras (vendor/admin auth guard).
# SUPABASE_URL + SUPABASE_ANON_KEY are required above (JWKS via SUPABASE_URL).
# Service-role key — required for pos_transactions ledger writes + market_sales_snapshots rollup (Phase B/C).
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 projects only:
SUPABASE_JWT_SECRET=

# --- Square ---
# Production app: developer.squareup.com → OAuth → Redirect URL (exact match) =
#   https://rooted-app-production-43fb.up.railway.app/pos/oauth/square/callback
# Required on Railway (Nest POS page). Name is SQUARE_APPLICATION_SECRET (not CLIENT_SECRET).
# See docs/SQUARE_SETUP.md for the full checklist.
SQUARE_ENVIRONMENT=production
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# Application access token (Credentials tab — NOT the OAuth secret). Required for webhooks.
SQUARE_ACCESS_TOKEN=
# Fallback global webhook signing key. Auto-registered connections store their own
# per-subscription signature_key on the connection, so this is only a fallback.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Optional: comma-separated override of subscribed webhook event types. These must
# also be enabled on the Square application's Webhooks settings.
SQUARE_WEBHOOK_EVENT_TYPES=

# --- Toast ---
# TODO: verify with provider docs (Toast partner onboarding / credentials model)
TOAST_ENVIRONMENT=sandbox
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_WEBHOOK_SECRET=

# --- Clover ---
CLOVER_ENVIRONMENT=sandbox
CLOVER_APP_ID=
CLOVER_APP_SECRET=
CLOVER_WEBHOOK_SECRET=

# --- Market discovery agent (daily sync every 24h at 04:00 server time) ---
# Apply docs/supabase/phase13_market_agent.sql + phase14 + phase15 + phase21 first.
MARKETS_AGENT_ENABLED=false
MARKETS_AGENT_CRON_ENABLED=true
# deep = tiled Overpass + Nominatim metros per state (~60–90 min). fast = Overpass only.
MARKETS_DISCOVERY_MODE=deep
MARKETS_DISCOVERY_ENABLED=true
MARKETS_REFRESH_BATCH=500
# Bulk catalog enrichment (all imported markets): batch size per run / npm run markets:enrich
MARKETS_ENRICH_BATCH=50
MARKETS_ENRICH_DELAY_MS=300
# Optional Nominatim lookup before AI for named markets (slow; off by default for bulk).
MARKETS_CATALOG_NOMINATIM=false
# Optional: enrich market type, hours, parking, extra info with OpenAI (server-side only).
# Fills what_to_look_for, market_highlights, vendor categories, and shopper tips for USDA markets.
OPENAI_API_KEY=
MARKETS_AI_ENRICH=true
MARKETS_AI_ENRICH_ALWAYS=false
MARKETS_AI_MODEL=gpt-4o-mini

# --- Google Places photos (optional fallback — costs ~$0.04/market) ---
# Cheapest: leave GOOGLE_PLACES_API_KEY empty and use npm run markets:images (free).
# With a key: free OSM/Commons/website runs first; Google only when those find nothing.
GOOGLE_PLACES_API_KEY=
MARKETS_GOOGLE_PLACES_ENABLED=true
# Set false to stay on free sources only (Commons geosearch + website og:image + vision).
MARKETS_GOOGLE_PLACES_FALLBACK=false

# --- USDA Local Food Directory (Meet the Makers + markets:usda:seed) ---
# Prefer root `../.env` USDA_API_KEY (loaded by ConfigModule envFilePath).
# listinginfo hours enrichment works without a key; state directory sync needs it.
USDA_API_KEY=

# --- Market image vision verification (OpenAI — pennies per image) ---
# Commons geosearch + website og:image require vision approval before saving.
MARKETS_IMAGE_VISION_ENABLED=true
MARKETS_IMAGE_VISION_MIN_CONFIDENCE=0.85
MARKETS_IMAGE_VISION_MODEL=gpt-4o-mini
# PUBLIC_BASE_URL must be reachable from phones when using Google proxy URLs.

# --- AI admin agent (vendor application triage — human still approves/rejects) ---
# Apply docs/supabase/phase17_admin_agent.sql first.
ADMIN_VENDOR_AGENT_ENABLED=false
ADMIN_VENDOR_AGENT_CRON_ENABLED=true
# Pending vendors reviewed per run (nightly cron + npm run admin:agent).
ADMIN_VENDOR_REVIEW_BATCH=20
ADMIN_VENDOR_REVIEW_DELAY_MS=400
ADMIN_VENDOR_AI_MODEL=gpt-4o-mini
# Past approve/reject decisions injected into each AI review prompt.
ADMIN_VENDOR_FEEDBACK_EXAMPLES=15

# --- AI post/video moderation ---
# Apply docs/supabase/phase19_post_moderation.sql first.
ADMIN_POST_AGENT_ENABLED=false
ADMIN_POST_AGENT_CRON_ENABLED=true
ADMIN_POST_MODERATION_BATCH=25
ADMIN_POST_MODERATION_DELAY_MS=500
ADMIN_POST_AI_MODEL=gpt-4o-mini
ADMIN_POST_FEEDBACK_EXAMPLES=15

# --- AI community event verify + local discovery ingest ---
# Apply docs/supabase/migrations/20260717_ai_ingestion.sql (+ community_events migrations).
ADMIN_COMMUNITY_EVENT_AI_MODEL=gpt-4o-mini
ADMIN_EVENT_INGEST_AI_MODEL=gpt-4o-mini

# --- Local network seed (Denver stress cluster) ---
# DATABASE_URL=... npm run db:seed:network
# Or admin POST /admin/seed-network

# --- Stripe (Phase 32 — Connect + Checkout) ---
# Apply docs/supabase/phase32_stripe_messaging.sql in Supabase first.
# Test keys: dashboard.stripe.com → Developers → API keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret from Stripe CLI (`stripe listen`) or Dashboard endpoint.
# Register https://api.vendorlymarketplace.app/webhooks/stripe (or /stripe/webhooks) in Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=
# Optional override of platform fee in basis points (default 500 = 5%).
# Platform fee in basis points (500 = 5%). Used by checkout + Stripe Connect settlement.
STRIPE_PLATFORM_FEE_BPS=500

# --- Elasticsearch (Phase 8 — wholesale discovery indexer) ---
# Optional. When unset, catalog mutations stay online and skip ES sync.
# Local: docker compose up -d elasticsearch  → http://localhost:9200
ELASTICSEARCH_NODE=
ELASTICSEARCH_WHOLESALE_INDEX=wholesale_products
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=

# Hybrid discovery ranking (CONNECTED_WHOLESALERS multiplicative boost).
# Default multiplier is 1.2 (score * 1.2). Empty connections = raw scores.
# CONNECTED_WHOLESALER_SCORE_MULTIPLIER=1.2
# PROXIMITY_SCORE_WEIGHT=0.15
# Set true to emit SEARCH_SCORE_CALCULATED base/boost/final composition logs.
DEBUG_SEARCH_RANKING=false

# Partition-aware order → Elasticsearch partial sync (hourly cron).
# Default: enabled when NODE_ENV=production. Set false to disable in prod.
# DISCOVERY_PARTITION_SYNC_CRON_ENABLED=true
# Recent monthly partitions scanned per sync (default 3).
# DISCOVERY_PARTIAL_INDEX_MONTHS=3
