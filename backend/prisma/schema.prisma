// Rooted backend Prisma schema.
//
// This schema layers a NestJS/Prisma backend on top of the existing Supabase
// Postgres database. The "existing Rooted tables" below are intentionally
// abbreviated to the columns the POS layer needs and are mapped to the existing
// snake_case tables via @@map. The POS_* models are the new additions for the
// POS integration system.

generator client {
  provider = "prisma-client-js"
}

// Runtime DATABASE_URL should be the Supabase transaction pooler
// (*.pooler.supabase.com:6543?pgbouncer=true). For migrate/deploy from a
// machine with IPv4, temporarily use the direct db.*.supabase.co:5432 URI.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Existing Rooted tables (abbreviated; managed by the mobile/Supabase layer).
// ===========================================================================

/// Legacy auth/ops row. Marketplace sticker role syncs from `profiles`.
/// Ops roles chef/admin remain here only.
model User {
  id               String   @id @db.Uuid
  role             String
  email            String?
  shopperInterests String[] @default([]) @map("shopper_interests")
  shopperZipCode   String?  @map("shopper_zip_code")
  vendorSpecialties String[] @default([]) @map("vendor_specialties")
  farmerSpecialties String[] @default([]) @map("farmer_specialties")

  shopper      Shopper?
  transactions Transaction[]

  @@map("users")
}

/// Vision profiles table — permanent sticker enum shopper|vendor|farmer.
model Profile {
  id               String   @id @db.Uuid
  role             String? // profile_role enum: shopper | vendor | farmer
  shopperInterests String[] @default([]) @map("shopper_interests")
  shopperZipCode   String?  @map("shopper_zip_code")
  vendorSpecialties String[] @default([]) @map("vendor_specialties")
  farmerSpecialties String[] @default([]) @map("farmer_specialties")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  followsAsShopper  Follow[] @relation("FollowShopper")
  followsAsFollowed Follow[] @relation("FollowTarget")
  connectionsSent     VendorConnection[] @relation("NetworkSender")
  connectionsReceived VendorConnection[] @relation("NetworkReceiver")

  @@map("profiles")
}

model Follow {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopperId         String  @map("shopper_id") @db.Uuid
  shopper           Profile @relation("FollowShopper", fields: [shopperId], references: [id], onDelete: Cascade)
  followedProfileId String  @map("followed_profile_id") @db.Uuid
  followed          Profile @relation("FollowTarget", fields: [followedProfileId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([shopperId, followedProfileId])
  @@index([shopperId])
  @@index([followedProfileId])
  @@map("follows")
}

model VendorConnection {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  sender     Profile  @relation("NetworkSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String   @map("receiver_id") @db.Uuid
  receiver   Profile  @relation("NetworkReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status     String   @default("pending") // pending | connected | ignored
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([senderId, status])
  @@index([receiverId, status])
  @@map("vendor_connections")
}

model Farmer {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  farmName        String?  @map("farm_name")
  farmDescription String?  @map("farm_description")
  logoUrl         String?  @map("logo_url")
  bannerUrl       String?  @map("banner_url")
  sellCity        String?  @map("sell_city")
  sellState       String?  @map("sell_state")
  postalCode      String?  @map("postal_code")
  approvalStatus  String   @default("pending") @map("approval_status")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("farmers")
}

model Shopper {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String  @unique @map("user_id") @db.Uuid
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests       String[] @default([])
  /// Phase 51 — localize USDA / nearby market feeds
  zipCode         String? @map("zip_code")
  savedVendors    String[] @default([]) @map("saved_vendors") @db.Uuid
  savedEvents     String[] @default([]) @map("saved_events") @db.Uuid
  defaultLocation String? @map("default_location")

  orders Order[]

  @@map("shoppers")
}

model Vendor {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  businessName String? @map("business_name")
  portfolioGallery String[] @default([]) @map("portfolio_gallery")
  payoutsEnabled   Boolean  @default(false) @map("payouts_enabled")

  stripeAccountId      String? @map("stripe_account_id")
  stripeChargesEnabled Boolean @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled Boolean @default(false) @map("stripe_payouts_enabled")

  /// Phase 49 — pickup_only | stripe_only | pickup_or_stripe
  preorderPaymentPolicy String  @default("pickup_or_stripe") @map("preorder_payment_policy")
  /// Phase 49 — booth accepts SNAP/EBT (discovery)
  acceptsSnapEbt        Boolean @default(false) @map("accepts_snap_ebt")

  posts                Post[]
  certifications       VendorCertification[]
  orders               Order[]
  vendorEvents         VendorEvent[]
  posConnections       PosConnection[]
  posProductMappings   PosProductMapping[]
  posTransactions      PosImportedTransaction[]
  marketRegistrations  VendorMarketRegistration[]
  businessConnectionsSent     VendorBusinessConnection[] @relation("BusinessConnectionSender")
  businessConnectionsReceived VendorBusinessConnection[] @relation("BusinessConnectionReceiver")
  wholesaleProducts           WholesaleProduct[]
  wholesaleOrdersAsBuyer      WholesaleOrder[]           @relation("WholesaleOrderBuyer")
  wholesaleOrdersAsSeller     WholesaleOrder[]           @relation("WholesaleOrderSeller")

  @@index([userId])
  @@map("vendors")
}

/// B2B wholesale partnership edge between directory Vendor rows (phase54).
/// Distinct from profile-level vendor_connections (social/network handshakes).
enum VendorBusinessConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED

  @@map("vendor_business_connection_status")
}

model VendorBusinessConnection {
  id               String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderVendorId   String                          @map("sender_vendor_id") @db.Uuid
  senderVendor     Vendor                          @relation("BusinessConnectionSender", fields: [senderVendorId], references: [id], onDelete: Cascade)
  receiverVendorId String                          @map("receiver_vendor_id") @db.Uuid
  receiverVendor   Vendor                          @relation("BusinessConnectionReceiver", fields: [receiverVendorId], references: [id], onDelete: Cascade)
  status           VendorBusinessConnectionStatus  @default(PENDING)
  initiatedAt      DateTime                        @default(now()) @map("initiated_at") @db.Timestamptz(6)
  updatedAt        DateTime                        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([senderVendorId, receiverVendorId])
  @@index([senderVendorId, status])
  @@index([receiverVendorId, status])
  @@index([initiatedAt])
  @@map("vendor_business_connections")
}

enum WholesaleProductStatus {
  ACTIVE
  ARCHIVED

  @@map("wholesale_product_status")
}

/// Bulk wholesale catalog SKU — distinct from consumer-facing Product rows.
model WholesaleProduct {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId        String                 @map("vendor_id") @db.Uuid
  vendor          Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  /// Packaging unit label (CASE, CRATE, BIN, LB, KG, EACH, ...).
  packagingUnit   String                 @map("packaging_unit")
  /// Fractional net weight per packaging unit (lbs).
  weightLbs       Decimal                @map("weight_lbs") @db.Decimal(12, 4)
  /// Minimum order quantity in packaging units.
  moq             Int
  /// Base unit price in cents for orders at MOQ.
  unitPriceCents  Int                    @map("unit_price_cents")
  /// Volume tiers: [{ "minQty": 10, "unitPriceCents": 1200 }, ...]
  pricingTiers    Json                   @default("[]") @map("pricing_tiers")
  freightNotes    String?                @map("freight_notes")
  pickupNotes     String?                @map("pickup_notes")
  /// Units available for wholesale reservation (phase57).
  availableQuantity Int                  @default(0) @map("available_quantity")
  status          WholesaleProductStatus @default(ACTIVE)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  orderItems      WholesaleOrderItem[]

  @@index([vendorId, status])
  @@index([vendorId, name])
  @@map("wholesale_products")
}

/// Draft → seller response statuses (phase56/57).
enum WholesaleOrderStatus {
  ORDER_DRAFT_INITIALIZED
  ORDER_ACCEPTED_BY_SELLER
  ORDER_REJECTED_BY_SELLER

  @@map("wholesale_order_status")
}

/// Multi-tenant B2B wholesale order draft header.
model WholesaleOrder {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerVendorId  String               @map("buyer_vendor_id") @db.Uuid
  buyerVendor    Vendor               @relation("WholesaleOrderBuyer", fields: [buyerVendorId], references: [id], onDelete: Cascade)
  sellerVendorId String               @map("seller_vendor_id") @db.Uuid
  sellerVendor   Vendor               @relation("WholesaleOrderSeller", fields: [sellerVendorId], references: [id], onDelete: Cascade)
  status         WholesaleOrderStatus @default(ORDER_DRAFT_INITIALIZED)
  currency       String               @default("USD")
  subtotalCents  Int                  @map("subtotal_cents")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items          WholesaleOrderItem[]

  @@index([buyerVendorId, status])
  @@index([sellerVendorId, status])
  @@index([createdAt])
  @@map("wholesale_orders")
}

model WholesaleOrderItem {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                  String           @map("order_id") @db.Uuid
  order                    WholesaleOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productSkuId             String           @map("product_sku_id") @db.Uuid
  product                  WholesaleProduct @relation(fields: [productSkuId], references: [id], onDelete: Restrict)
  quantity                 Int
  negotiatedTierUnitPrice  Int              @map("negotiated_tier_unit_price")
  lineTotalCents           Int              @map("line_total_cents")
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([productSkuId])
  @@map("wholesale_order_items")
}

model Product {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId String @map("vendor_id") @db.Uuid
  name     String
  price    Int

  /// Phase 49 — SNAP/EBT eligible SKU
  isSnapEligible Boolean @default(false) @map("is_snap_eligible")

  availability       ProductEventAvailability[]
  orderItems         OrderItem[]
  posProductMappings PosProductMapping[]
  posLineItems       PosImportedLineItem[]
  inventoryTransactions InventoryTransaction[]

  @@map("products")
}

model Event {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  description      String?
  organizerName    String?   @map("organizer_name")
  bannerUrl        String?   @map("banner_url")
  startDatetime    DateTime  @map("start_datetime") @db.Timestamptz(6)
  endDatetime      DateTime  @map("end_datetime") @db.Timestamptz(6)
  address          String?
  city             String?
  state            String?
  latitude         Decimal   @db.Decimal
  longitude        Decimal   @db.Decimal
  eventStatus      String    @default("upcoming") @map("event_status")
  visibilityStatus String    @default("public") @map("visibility_status")
  parkingInfo      String?   @map("parking_info")
  admissionInfo    String?   @map("admission_info")
  marketType       String?   @map("market_type")
  hoursSummary     String?   @map("hours_summary")
  websiteUrl       String?   @map("website_url")
  extraInfo        String?   @map("extra_info")
  marketHistory    String?   @map("market_history")
  whatToLookFor    String?   @map("what_to_look_for")
  marketHighlights String?   @map("market_highlights")
  timezone         String?
  externalSource   String?   @map("external_source")
  externalId       String?   @map("external_id")
  lastSyncedAt     DateTime? @map("last_synced_at") @db.Timestamptz(6)
  syncMetadata     Json      @default("{}") @map("sync_metadata")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  posLocationMappings PosLocationMapping[]
  orders              Order[]
  productAvailability ProductEventAvailability[]
  vendorEvents        VendorEvent[]
  tenants             Tenant[]
  markets             Market[]
  inventoryTransactions InventoryTransaction[]

  @@unique([externalSource, externalId])
  @@map("events")
}

// ===========================================================================
// Multi-tenant marketplace routing (custom domains + platform subdomains).
// ===========================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// A branded marketplace instance (farmers market, food hub, etc.).
model Tenant {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String       @unique
  displayName String       @map("display_name")
  status      TenantStatus @default(ACTIVE)
  eventId     String?      @map("event_id") @db.Uuid
  event       Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  logoUrl     String?      @map("logo_url")
  faviconUrl  String?      @map("favicon_url")
  primaryColor String?     @map("primary_color")
  accentColor  String?     @map("accent_color")
  tagline     String?
  metadata    Json         @default("{}")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  domains         TenantDomain[]
  posIntegrations TenantPosIntegration[]

  @@index([status])
  @@index([eventId])
  @@map("tenants")
}

/// Hostname routing table — custom domains and explicit subdomain aliases.
model TenantDomain {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  host      String   @unique
  isPrimary Boolean  @default(false) @map("is_primary")
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([tenantId, isPrimary])
  @@map("tenant_domains")
}

/// Public POS integration metadata scoped to a tenant (no secrets).
model TenantPosIntegration {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider           PosProvider
  status             PosConnectionStatus @default(PENDING)
  providerAppId      String?             @map("provider_app_id")
  providerLocationId String?             @map("provider_location_id")
  webhookEndpoint    String?             @map("webhook_endpoint")
  metadata           Json?
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, provider])
  @@index([tenantId, active])
  @@index([tenantId, provider, active])
  @@map("tenant_pos_integrations")
}

// ===========================================================================
// Regional marketplace isolation (phase42_regional_markets.sql).
// ===========================================================================

enum RegionStatus {
  ACTIVE
  INACTIVE

  @@map("region_status")
}

enum MarketStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("market_status")
}

/// Geographic tenant boundary for multi-region marketplace isolation.
model Region {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  slug             String       @unique
  timezone         String       @default("America/Denver")
  geographicBounds Json         @default("{}") @map("geographic_bounds")
  status           RegionStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  markets Market[]

  @@index([status])
  @@map("regions")
}

/// Regional / nationwide farmers market directory entry (links to legacy events via eventId).
model Market {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  regionId        String        @map("region_id") @db.Uuid
  region          Region        @relation(fields: [regionId], references: [id], onDelete: Restrict)
  name            String
  /// Region-scoped slug (unique within region).
  slug            String
  /// Nationwide unique directory handle for tenant subdomain / SEO routing.
  directorySlug   String?       @unique @map("directory_slug")
  /// Regional description banner copy for tenant theme injection.
  description     String?
  locationAddress String?       @map("location_address")
  city            String?
  state           String?
  /// WGS84 latitude — used with longitude for bbox + haversine geo queries.
  latitude        Decimal?      @db.Decimal(10, 7)
  /// WGS84 longitude — used with latitude for bbox + haversine geo queries.
  longitude       Decimal?      @db.Decimal(10, 7)
  /// Free-text operating hours (e.g. "Sat 9:00-14:00").
  operatingHours  String?       @map("operating_hours")
  /// Optional marketplace theme primary (CSS --tenant-primary).
  themePrimaryColor String?     @map("theme_primary_color")
  /// Optional marketplace theme accent (CSS --tenant-accent).
  themeAccentColor  String?     @map("theme_accent_color")
  posProvider     PosProvider?  @map("pos_provider")
  eventId         String?       @map("event_id") @db.Uuid
  event           Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  status          MarketStatus  @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  vendorRegistrations VendorMarketRegistration[]
  orders              Order[]

  @@unique([regionId, slug])
  @@index([regionId])
  @@index([status])
  @@index([eventId])
  @@index([state, city])
  @@index([city])
  @@index([state])
  @@index([latitude, longitude])
  @@map("markets")
}

/// Vendor membership in a regional market (RLS scoping for read/write boundaries).
model VendorMarketRegistration {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId           String   @map("vendor_id") @db.Uuid
  vendor             Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  marketId           String   @map("market_id") @db.Uuid
  market             Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  registrationStatus String   @default("requested") @map("registration_status")
  boothLabel         String?  @map("booth_label")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([vendorId, marketId])
  @@index([vendorId])
  @@index([marketId])
  @@index([registrationStatus])
  @@map("vendor_market_registrations")
}

model MarketSyncRun {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)
  status       String    @default("running")
  discovered   Int       @default(0)
  inserted     Int       @default(0)
  updated      Int       @default(0)
  skipped      Int       @default(0)
  errors       Json      @default("[]")
  agentVersion String?   @map("agent_version")
  notes        String?

  @@map("market_sync_runs")
}

model AdminAgentRun {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz(6)
  status            String    @default("running")
  agentType         String    @default("vendor_review") @map("agent_type")
  reviewed          Int       @default(0)
  suggestionsCount  Int       @default(0) @map("suggestions_count")
  skipped           Int       @default(0)
  errors            Json      @default("[]")
  agentVersion      String?   @map("agent_version")
  notes             String?

  vendorReviewSuggestions VendorReviewSuggestion[]

  @@map("admin_agent_runs")
}

model VendorReviewSuggestion {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId          String?        @map("run_id") @db.Uuid
  run            AdminAgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  vendorId       String         @map("vendor_id") @db.Uuid
  recommendation String
  confidence     Decimal        @db.Decimal(4, 3)
  summary        String
  flags          Json           @default("[]")
  reasons        Json           @default("[]")
  agentVersion   String?        @map("agent_version")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([vendorId, createdAt(sort: Desc)])
  @@map("vendor_review_suggestions")
}

model VendorReviewFeedback {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  suggestionId     String?  @map("suggestion_id") @db.Uuid
  vendorId         String   @map("vendor_id") @db.Uuid
  adminUserId      String   @map("admin_user_id") @db.Uuid
  aiRecommendation String?  @map("ai_recommendation")
  adminAction      String   @map("admin_action")
  outcome          String
  notes            String?
  vendorSnapshot   Json     @default("{}") @map("vendor_snapshot")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([outcome, createdAt(sort: Desc)])
  @@map("vendor_review_feedback")
}

model PostModerationSuggestion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId          String?  @map("run_id") @db.Uuid
  postId         String   @map("post_id") @db.Uuid
  recommendation String
  confidence     Decimal  @db.Decimal(4, 3)
  summary        String
  categories     Json     @default("[]")
  flags          Json     @default("[]")
  reasons        Json     @default("[]")
  agentVersion   String?  @map("agent_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([postId, createdAt(sort: Desc)])
  @@map("post_moderation_suggestions")
}

model PostModerationFeedback {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  suggestionId    String?  @map("suggestion_id") @db.Uuid
  postId          String   @map("post_id") @db.Uuid
  adminUserId     String   @map("admin_user_id") @db.Uuid
  aiRecommendation String? @map("ai_recommendation")
  adminAction     String   @map("admin_action")
  outcome         String
  notes           String?
  postSnapshot    Json     @default("{}") @map("post_snapshot")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@map("post_moderation_feedback")
}

model InventoryTransaction {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId        String   @map("vendor_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  eventId         String?  @map("event_id") @db.Uuid
  event           Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  transactionType String   @map("transaction_type")
  quantityChange  Int      @map("quantity_change")
  source          String?
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([vendorId, createdAt(sort: Desc)])
  @@map("inventory_transactions")
}

/// Per-event dual-channel inventory caps (Supabase `product_event_availability`).
model ProductEventAvailability {
  id                        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId                 String @map("product_id") @db.Uuid
  product                   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  eventId                   String @map("event_id") @db.Uuid
  event                     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  availableQuantityPresale  Int    @default(0) @map("available_quantity_presale")
  availableQuantityInperson Int    @default(0) @map("available_quantity_inperson")
  reservedQuantity          Int    @default(0) @map("reserved_quantity")
  preOrderDeadline          DateTime? @map("pre_order_deadline") @db.Timestamptz(6)
  pickupNotes               String?   @map("pickup_notes")

  @@unique([productId, eventId])
  @@index([productId])
  @@index([eventId])
  @@map("product_event_availability")
}

model AnalyticsSnapshot {
