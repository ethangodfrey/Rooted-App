  moderationStatus  String?  @map("moderation_status")
  publishAt         DateTime @default(now()) @map("publish_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([vendorId])
  @@index([createdAt(sort: Desc)])
