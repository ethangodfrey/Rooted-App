  vendorId      String   @map("vendor_id") @db.Uuid
  date          DateTime @db.Date
  revenueTotal  Int      @default(0) @map("revenue_total")
  ordersTotal   Int      @default(0) @map("orders_total")
  productViews  Int      @default(0) @map("product_views")
  conversions   Int      @default(0)
  eventSales    Int      @default(0) @map("event_sales")
  inpersonSales Int      @default(0) @map("inperson_sales")
  savedCount    Int      @default(0) @map("saved_count")
  followerCount Int      @default(0) @map("follower_count")

  @@unique([vendorId, date])
  @@map("analytics_snapshots")
}

model Post {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId          String   @map("vendor_id") @db.Uuid
  vendor            Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  eventId           String?  @map("event_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  postType          String   @map("post_type")
  caption           String
  content           String?
  mediaUrl          String?  @map("media_url")
  mediaType         String   @default("image") @map("media_type")
