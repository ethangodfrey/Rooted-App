  caption                  String
  content                  String?
  mediaUrl                 String?  @map("media_url")
  mediaType                String   @default("image") @map("media_type")
  videoThumbnailUrl        String?  @map("video_thumbnail_url")
  moderationStatus         String?  @map("moderation_status")
  /// Dual-posting primary author (profile / farmer / vendor id).
  contributorId            String?  @map("contributor_id") @db.Uuid
