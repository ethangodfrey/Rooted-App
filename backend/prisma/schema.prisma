  userId    String   @map("user_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  postId    String?  @map("post_id") @db.Uuid
  status    String   @default("RSVP")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, eventId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([eventId])
  @@map("user_events")
}

/// Phase 73 — daily engagement aggregates for farmer/vendor Performance dashboards.
model EngagementMetric {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityId   String   @map("entity_id") @db.Uuid
  /// FARMER | VENDOR
  entityType String   @map("entity_type")
  /// VIEW | INQUIRY | RSVP
  metricType String   @map("metric_type")
  metricDate DateTime @map("metric_date") @db.Date
  count      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([entityId, entityType, metricType, metricDate])
  @@index([entityId, metricDate(sort: Desc)])
  @@index([metricType, metricDate(sort: Desc)])
  @@map("engagement_metrics")
}

/// Phase 74 — automated weekly / anomaly partner performance reports.
model PartnerReport {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityId       String    @map("entity_id") @db.Uuid
  /// FARMER | VENDOR
  entityType     String    @map("entity_type")
  userId         String    @map("user_id") @db.Uuid
  periodStart    DateTime  @map("period_start") @db.Date
  periodEnd      DateTime  @map("period_end") @db.Date
  /// WEEKLY | ANOMALY
  reportType     String    @default("WEEKLY") @map("report_type")
  summaryText    String    @map("summary_text")
  metrics        Json      @default("{}")
  emailTo        String?   @map("email_to")
  /// PENDING | SENT | SKIPPED | FAILED
  emailStatus    String    @default("PENDING") @map("email_status")
  emailSentAt    DateTime? @map("email_sent_at") @db.Timestamptz(6)
  notificationId String?   @map("notification_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@index([entityId, createdAt(sort: Desc)])
  @@map("partner_reports")
}

model VendorCertification {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId       String    @map("vendor_id") @db.Uuid
  vendor         Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  certName       String    @map("cert_name")
  issuingBody    String?   @map("issuing_body")
  certNumber     String?   @map("cert_number")
  expirationDate DateTime? @map("expiration_date") @db.Date
  documentUrl    String?   @map("document_url")
  status         String    @default("pending")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([vendorId])
  @@index([status, expirationDate])
  @@map("vendor_certifications")
}

model Transaction {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId            String   @map("customer_id") @db.Uuid
  customer              User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stripePaymentIntentId String?  @map("stripe_payment_intent_id")
  totalAmount           Int      @map("total_amount")
  status                String   @default("authorized")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orders Order[]

  @@unique([stripePaymentIntentId])
  @@index([customerId, createdAt(sort: Desc)])
  @@map("transactions")
}

model Order {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId          String?      @map("transaction_id") @db.Uuid
  transaction            Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  shopperId              String       @map("shopper_id") @db.Uuid
  shopper                Shopper      @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  vendorId               String       @map("vendor_id") @db.Uuid
  vendor                 Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  eventId                String?      @map("event_id") @db.Uuid
  event                  Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  marketId               String?      @map("market_id") @db.Uuid
  market                 Market?      @relation(fields: [marketId], references: [id], onDelete: SetNull)
  leftoverListingId      String?      @map("leftover_listing_id") @db.Uuid
  orderType              String       @default("event_pickup") @map("order_type")
  orderStatus            String       @default("submitted") @map("order_status")
  paymentStatus          String       @default("unpaid") @map("payment_status")
  fulfillmentType        String?      @default("pickup") @map("fulfillment_type")
  pickupDatetime         DateTime?    @map("pickup_datetime") @db.Timestamptz(6)
  deliveryAddress        String?      @map("delivery_address")
  deliveryCity           String?      @map("delivery_city")
  deliveryState          String?      @map("delivery_state")
  scheduledDatetime      DateTime?    @map("scheduled_datetime") @db.Timestamptz(6)
  deliveryInstructions   String?      @map("delivery_instructions")
  subtotal               Int
  tax                    Int          @default(0)
  total                  Int
  platformFee            Int          @default(0) @map("platform_fee")
  pickupCode             String?      @unique @map("pickup_code")
  fulfillmentWindowStart DateTime?    @map("fulfillment_window_start") @db.Timestamptz(6)
  fulfillmentWindowEnd   DateTime?    @map("fulfillment_window_end") @db.Timestamptz(6)
  stripeCheckoutSessionId String?     @map("stripe_checkout_session_id")
  stripePaymentIntentId  String?      @map("stripe_payment_intent_id")
  notes                  String?
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItems OrderItem[]

  /// Phase 68 — partition-aligned indexes (RANGE by created_at).
  @@index([createdAt])
  @@index([shopperId, createdAt])
  @@index([vendorId, createdAt])
  @@index([shopperId])
  @@index([vendorId])
  @@index([transactionId])
  @@index([marketId])
  @@map("orders")
}

model OrderItem {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String   @map("order_id") @db.Uuid
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String?  @map("product_id") @db.Uuid
  product            Product? @relation(fields: [productId], references: [id], onDelete: NoAction)
  leftoverListingId  String?  @map("leftover_listing_id") @db.Uuid
  itemTitle          String?  @map("item_title")
  quantity           Int
  itemPrice          Int      @map("item_price")
  customizationData  Json?    @map("customization_data")
  fulfillmentStatus  String?  @map("fulfillment_status")
  /// Phase 68 — partition key for monthly RANGE partitioning.
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Parent order created_at for composite FK to partitioned orders.
  orderCreatedAt     DateTime? @map("order_created_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([productId])
  @@index([createdAt])
  @@index([orderId, createdAt])
  @@map("order_items")
}

model VendorEvent {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId            String   @map("vendor_id") @db.Uuid
  vendor              Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  eventId             String   @map("event_id") @db.Uuid
  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participationStatus String   @default("requested") @map("participation_status")
  boothDetails        String?  @map("booth_details")
  setupNotes          String?  @map("setup_notes")
  preOrderEnabled     Boolean  @default(true) @map("pre_order_enabled")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([vendorId, eventId])
  @@index([eventId])
  @@index([vendorId])
  @@map("vendor_events")
}

// ===========================================================================
// POS integration: enums
// ===========================================================================

enum PosProvider {
  SQUARE
  TOAST
  CLOVER
}

enum PosAuthType {
  OAUTH
  API_KEY
}

enum PosConnectionStatus {
  PENDING
  ACTIVE
  ERROR
  EXPIRED
  DISCONNECTED
}

enum PosSyncTrigger {
  MANUAL
  SCHEDULED
  WEBHOOK
  BACKFILL
}

enum PosSyncStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum PosTransactionState {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  VOIDED
}

enum PosWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum PosErrorScope {
  CONNECTION
  SYNC
  IMPORT
  WEBHOOK
  MAPPING
}

// ===========================================================================
// POS integration: models
// ===========================================================================

model PosConnection {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId             String              @map("vendor_id") @db.Uuid
  vendor               Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  provider             PosProvider
  authType             PosAuthType         @map("auth_type")
  status               PosConnectionStatus @default(PENDING)
  displayName          String?             @map("display_name")
  providerMerchantId   String?             @map("provider_merchant_id")
  providerLocationId   String?             @map("provider_location_id")
  scopes               String[]            @default([])
  webhookSecret        String?             @map("webhook_secret")
  oauthState           String?             @map("oauth_state")
  lastSyncedAt         DateTime?           @map("last_synced_at") @db.Timestamptz(6)
  lastCursor           String?             @map("last_cursor")
  syncFrequencyMinutes Int                 @default(60) @map("sync_frequency_minutes")
  errorMessage         String?             @map("error_message")
  metadata             Json?
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  credential       PosCredential?
  syncRuns         PosSyncRun[]
  transactions     PosImportedTransaction[]
  productMappings  PosProductMapping[]
  locationMappings PosLocationMapping[]
  webhookEvents    PosWebhookEvent[]
  errors           PosSyncError[]

  @@unique([vendorId, provider, providerMerchantId])
  @@index([status])
  @@map("pos_connections")
}

/// Encrypted credential vault (AES-256-GCM). Never exposed via the API.
model PosCredential {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId  String        @unique @map("connection_id") @db.Uuid
  connection    PosConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  secretCipher  String        @map("secret_cipher")
  cipherIv      String        @map("cipher_iv")
  cipherAuthTag String        @map("cipher_auth_tag")
  keyVersion    Int           @default(1) @map("key_version")
  expiresAt     DateTime?     @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("pos_credentials")
}

model PosSyncRun {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId         String         @map("connection_id") @db.Uuid
  connection           PosConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  trigger              PosSyncTrigger
  status               PosSyncStatus  @default(QUEUED)
  windowStart          DateTime?      @map("window_start") @db.Timestamptz(6)
  windowEnd            DateTime?      @map("window_end") @db.Timestamptz(6)
  startedAt            DateTime?      @map("started_at") @db.Timestamptz(6)
  finishedAt           DateTime?      @map("finished_at") @db.Timestamptz(6)
  cursorStart          String?        @map("cursor_start")
  cursorEnd            String?        @map("cursor_end")
  transactionsFetched  Int            @default(0) @map("transactions_fetched")
  transactionsImported Int            @default(0) @map("transactions_imported")
  transactionsSkipped  Int            @default(0) @map("transactions_skipped")
  errorCount           Int            @default(0) @map("error_count")
  errorMessage         String?        @map("error_message")
  jobId                String?        @map("job_id")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  transactions PosImportedTransaction[]
  errors       PosSyncError[]

  @@index([connectionId, status])
  @@map("pos_sync_runs")
}

/// Provider-agnostic normalized transaction.
model PosImportedTransaction {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId          String              @map("connection_id") @db.Uuid
  connection            PosConnection       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  vendorId              String              @map("vendor_id") @db.Uuid
  vendor                Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  syncRunId             String?             @map("sync_run_id") @db.Uuid
  syncRun               PosSyncRun?         @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  provider              PosProvider
  providerTransactionId String              @map("provider_transaction_id")
  providerOrderId       String?             @map("provider_order_id")
  providerLocationId    String?             @map("provider_location_id")
  state                 PosTransactionState @default(COMPLETED)
  soldAt                DateTime            @map("sold_at") @db.Timestamptz(6)
  currency              String              @default("USD")
  grossAmount           Int                 @map("gross_amount")
  discountAmount        Int                 @default(0) @map("discount_amount")
  taxAmount             Int                 @default(0) @map("tax_amount")
  tipAmount             Int                 @default(0) @map("tip_amount")
  netAmount             Int                 @map("net_amount")
  tenderType            String?             @map("tender_type")
  cardBrand             String?             @map("card_brand")
  eventId               String?             @map("event_id") @db.Uuid
  rawPayload            Json                @map("raw_payload")
  importedAt            DateTime            @default(now()) @map("imported_at") @db.Timestamptz(6)

  lineItems PosImportedLineItem[]

  @@unique([connectionId, providerTransactionId])
  @@index([vendorId, soldAt])
  @@map("pos_imported_transactions")
}

model PosImportedLineItem {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId           String                 @map("transaction_id") @db.Uuid
  transaction             PosImportedTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  providerLineItemId      String?                @map("provider_line_item_id")
  providerCatalogObjectId String?                @map("provider_catalog_object_id")
  name                    String
  quantity                Int                    @default(1)
  unitPrice               Int                    @map("unit_price")
  grossAmount             Int                    @map("gross_amount")
  discountAmount          Int                    @default(0) @map("discount_amount")
  taxAmount               Int                    @default(0) @map("tax_amount")
  productId               String?                @map("product_id") @db.Uuid
  product                 Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Set once an InventoryTransaction has been written for this line (idempotency guard).
  inventoryTransactionId  String?                @unique @map("inventory_transaction_id") @db.Uuid
  rawPayload              Json?                  @map("raw_payload")

  @@index([transactionId])
  @@index([providerCatalogObjectId])
  @@map("pos_imported_line_items")
}

/// Maps a provider catalog object to a Rooted product.
model PosProductMapping {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId            String        @map("connection_id") @db.Uuid
  connection              PosConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  vendorId                String        @map("vendor_id") @db.Uuid
  vendor                  Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  provider                PosProvider
  providerCatalogObjectId String        @map("provider_catalog_object_id")
  providerItemName        String?       @map("provider_item_name")
  productId               String?       @map("product_id") @db.Uuid
  product                 Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  autoMatched             Boolean       @default(false) @map("auto_matched")
  ignored                 Boolean       @default(false)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([connectionId, providerCatalogObjectId])
  @@index([vendorId])
  @@map("pos_product_mappings")
}

/// Maps a provider location to a Rooted event context (optional).
model PosLocationMapping {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId         String        @map("connection_id") @db.Uuid
  connection           PosConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  provider             PosProvider
  providerLocationId   String        @map("provider_location_id")
  providerLocationName String?       @map("provider_location_name")
  eventId              String?       @map("event_id") @db.Uuid
  event                Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([connectionId, providerLocationId])
  @@map("pos_location_mappings")
}

/// Raw inbound webhook envelopes (idempotent on provider event id).
model PosWebhookEvent {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId    String?          @map("connection_id") @db.Uuid
  connection      PosConnection?   @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  provider        PosProvider
  providerEventId String           @map("provider_event_id")
  eventType       String           @map("event_type")
  status          PosWebhookStatus @default(RECEIVED)
  signatureValid  Boolean          @default(false) @map("signature_valid")
  payload         Json
  receivedAt      DateTime         @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime?        @map("processed_at") @db.Timestamptz(6)
  error           String?

  @@unique([provider, providerEventId])
  @@index([status])
  @@map("pos_webhook_events")
}

model PosSyncError {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId      String        @map("connection_id") @db.Uuid
  connection        PosConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  syncRunId         String?       @map("sync_run_id") @db.Uuid
  syncRun           PosSyncRun?   @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  scope             PosErrorScope
  code              String?
  message           String
  providerReference String?       @map("provider_reference")
  payload           Json?
  retryable         Boolean       @default(false)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([connectionId, scope])
  @@map("pos_sync_errors")
}
