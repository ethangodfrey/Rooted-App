// Rooted backend Prisma schema.
//
// This schema layers a NestJS/Prisma backend on top of the existing Supabase
// Postgres database. The "existing Rooted tables" below are intentionally
// abbreviated to the columns the POS layer needs and are mapped to the existing
// snake_case tables via @@map. The POS_* models are the new additions for the
// POS integration system.

generator client {
  provider = "prisma-client-js"
}

// Runtime DATABASE_URL should be the Supabase transaction pooler
// (*.pooler.supabase.com:6543?pgbouncer=true). For migrate/deploy from a
// machine with IPv4, temporarily use the direct db.*.supabase.co:5432 URI.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Existing Rooted tables (abbreviated; managed by the mobile/Supabase layer).
// ===========================================================================

/// Legacy auth/ops row. Marketplace sticker role syncs from `profiles`.
/// Ops roles chef/admin remain here only.
model User {
  id               String   @id @db.Uuid
  role             String
  email            String?
  shopperInterests String[] @default([]) @map("shopper_interests")
  shopperZipCode   String?  @map("shopper_zip_code")
  vendorSpecialties String[] @default([]) @map("vendor_specialties")
  farmerSpecialties String[] @default([]) @map("farmer_specialties")

  shopper      Shopper?
  transactions Transaction[]

  @@map("users")
}

/// Vision profiles table — permanent sticker enum shopper|vendor|farmer.
model Profile {
  id               String   @id @db.Uuid
  role             String? // profile_role enum: shopper | vendor | farmer
  shopperInterests String[] @default([]) @map("shopper_interests")
  shopperZipCode   String?  @map("shopper_zip_code")
  vendorSpecialties String[] @default([]) @map("vendor_specialties")
  farmerSpecialties String[] @default([]) @map("farmer_specialties")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  followsAsShopper  Follow[] @relation("FollowShopper")
  followsAsFollowed Follow[] @relation("FollowTarget")
  connectionsSent     VendorConnection[] @relation("NetworkSender")
  connectionsReceived VendorConnection[] @relation("NetworkReceiver")

  @@map("profiles")
}

model Follow {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopperId         String  @map("shopper_id") @db.Uuid
  shopper           Profile @relation("FollowShopper", fields: [shopperId], references: [id], onDelete: Cascade)
  followedProfileId String  @map("followed_profile_id") @db.Uuid
  followed          Profile @relation("FollowTarget", fields: [followedProfileId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([shopperId, followedProfileId])
  @@index([shopperId])
  @@index([followedProfileId])
  @@map("follows")
}

model VendorConnection {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  sender     Profile  @relation("NetworkSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String   @map("receiver_id") @db.Uuid
  receiver   Profile  @relation("NetworkReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status     String   @default("pending") // pending | connected | ignored
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([senderId, status])
  @@index([receiverId, status])
  @@map("vendor_connections")
}

model Farmer {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  farmName        String?  @map("farm_name")
  farmDescription String?  @map("farm_description")
  logoUrl         String?  @map("logo_url")
  bannerUrl       String?  @map("banner_url")
  sellCity        String?  @map("sell_city")
  sellState       String?  @map("sell_state")
  postalCode      String?  @map("postal_code")
  approvalStatus  String   @default("pending") @map("approval_status")
  /// Phase 75 — B2B peer marketplace wholesale supplier flag.
  isWholesaleSupplier Boolean @default(false) @map("is_wholesale_supplier")
  /// Phase 80 — Stripe Connect Express account for wholesale payouts.
  stripeAccountId String?  @map("stripe_account_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("farmers")
}

model Shopper {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String  @unique @map("user_id") @db.Uuid
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests       String[] @default([])
  /// Phase 51 — localize USDA / nearby market feeds
  zipCode         String? @map("zip_code")
  savedVendors    String[] @default([]) @map("saved_vendors") @db.Uuid
  savedEvents     String[] @default([]) @map("saved_events") @db.Uuid
  defaultLocation String? @map("default_location")

  orders Order[]

  loyalty ShopperLoyalty?

  @@map("shoppers")
}

model Vendor {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  businessName String? @map("business_name")
  portfolioGallery String[] @default([]) @map("portfolio_gallery")
  payoutsEnabled   Boolean  @default(false) @map("payouts_enabled")

  stripeAccountId      String? @map("stripe_account_id")
  stripeChargesEnabled Boolean @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled Boolean @default(false) @map("stripe_payouts_enabled")

  /// Phase 49 — pickup_only | stripe_only | pickup_or_stripe
  preorderPaymentPolicy String  @default("pickup_or_stripe") @map("preorder_payment_policy")
  /// Phase 49 — booth accepts SNAP/EBT (discovery)
  acceptsSnapEbt        Boolean @default(false) @map("accepts_snap_ebt")

  /// Phase 72 — optional catering provider module
  isCateringProvider    Boolean @default(false) @map("is_catering_provider")
  /// Phase 75 — B2B peer marketplace wholesale provider flag.
  isWholesaleProvider   Boolean @default(false) @map("is_wholesale_provider")
  /// Phase 76 — Precision Rewards opt-in (shopper redemption eligibility).
  rewardsOptIn          Boolean @default(false) @map("rewards_opt_in")
  /// Phase 76 — vendor-funded boost micro-fee balance (integer cents).
  rewardsBoostBalanceCents Int  @default(0) @map("rewards_boost_balance_cents")

  /// Phase 24/27 — WGS84 vendor pin + country (default USA in Supabase).
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  country   String?

  posts                Post[]
  certifications       VendorCertification[]
  cateringService      VendorCateringService?
  cateringInquiries    CateringInquiry[]
  availabilityBlocks   VendorAvailability[]
  rewardsBoosts        VendorRewardsBoost[]
  loyaltyRedemptions   LoyaltyRedemption[]
  vendorBalance        VendorBalance?
  orders               Order[]
  vendorEvents         VendorEvent[]
  posConnections       PosConnection[]
  posProductMappings   PosProductMapping[]
  posTransactions      PosImportedTransaction[]
  marketRegistrations  VendorMarketRegistration[]
  businessConnectionsSent     VendorBusinessConnection[] @relation("BusinessConnectionSender")
  businessConnectionsReceived VendorBusinessConnection[] @relation("BusinessConnectionReceiver")
  peerConnectionsRequested    VendorPeerConnection[]     @relation("PeerConnectionRequestor")
  peerConnectionsReceived     VendorPeerConnection[]     @relation("PeerConnectionRecipient")
  wholesaleProducts           WholesaleProduct[]
  wholesaleOrdersAsBuyer      WholesaleOrder[]           @relation("WholesaleOrderBuyer")
  wholesaleOrdersAsSeller     WholesaleOrder[]           @relation("WholesaleOrderSeller")
  procurementRequests         B2bProcurementRequest[]

  @@index([userId])
  @@index([latitude, longitude])
  @@map("vendors")
}

/// Phase 72 — one catering services summary row per vendor.
model VendorCateringService {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId             String   @unique @map("vendor_id") @db.Uuid
  vendor               Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  serviceDescription   String   @default("") @map("service_description")
  minGuests            Int      @default(1) @map("min_guests")
  maxGuests            Int      @default(50) @map("max_guests")
  priceRangeEstimate   String?  @map("price_range_estimate")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([vendorId])
  @@map("vendor_catering_services")
}

/// Phase 72 — shopper catering inquiry / contact request.
model CateringInquiry {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId          String    @map("vendor_id") @db.Uuid
  vendor            Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  shopperId         String    @map("shopper_id") @db.Uuid
  message           String
  guestCount        Int?      @map("guest_count")
  eventDate         DateTime? @map("event_date") @db.Date
  status            String    @default("OPEN")
  /// Phase 77 — true when event_date conflicts with vendor_availability.
  conflictDetected  Boolean   @default(false) @map("conflict_detected")
  conflictWarning   String?   @map("conflict_warning")
  /// Phase 78 — catering deposit escrow fields (integer cents).
  depositCents         Int?    @map("deposit_cents")
  voucherCentsApplied  Int     @default(0) @map("voucher_cents_applied")
  escrowTransactionId  String? @map("escrow_transaction_id") @db.Uuid
  /// Phase 73 — append-only VIEW/CLICK interaction payloads.
  interactionEvents Json      @default("[]") @map("interaction_events")
  viewCount         Int       @default(0) @map("view_count")
  clickCount        Int       @default(0) @map("click_count")
  lastInteractionAt DateTime? @map("last_interaction_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([vendorId, createdAt(sort: Desc)])
  @@index([shopperId, createdAt(sort: Desc)])
  @@map("catering_inquiries")
}

/// Phase 75 — peer B2B marketplace bulk listing (farmer/vendor producer).
model WholesaleListing {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  producerId         String   @map("producer_id") @db.Uuid
  /// FARMER | VENDOR
  producerType       String   @default("FARMER") @map("producer_type")
  itemName           String   @map("item_name")
  bulkUnitPrice      Decimal  @map("bulk_unit_price") @db.Decimal(12, 2)
  minOrderQuantity   Int      @default(1) @map("min_order_quantity")
  /// AVAILABLE | LIMITED | UNAVAILABLE
  availabilityStatus String   @default("AVAILABLE") @map("availability_status")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  procurementRequests B2bProcurementRequest[]

  @@index([producerType, producerId, createdAt(sort: Desc)])
  @@map("wholesale_listings")
}

/// Phase 75 — vendor → farmer bulk procurement / connection request.
model B2bProcurementRequest {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId          String   @map("vendor_id") @db.Uuid
  vendor            Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  farmerId          String   @map("farmer_id") @db.Uuid
  listingId         String?  @map("listing_id") @db.Uuid
  listing           WholesaleListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  message           String?
  requestedQuantity Int?     @map("requested_quantity")
  /// PENDING | ACCEPTED | DECLINED | CANCELLED
  status            String   @default("PENDING")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([vendorId, farmerId, listingId])
  @@index([vendorId, createdAt(sort: Desc)])
  @@index([farmerId, createdAt(sort: Desc)])
  @@map("b2b_procurement_requests")
}

/// Phase 75 / Phase 2 prep — calendar blocked dates (CATERING | MARKET).
model VendorAvailability {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  blockedDate DateTime @map("blocked_date") @db.Date
  /// CATERING | MARKET
  reason      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([vendorId, blockedDate, reason])
  @@index([vendorId, blockedDate])
  @@map("vendor_availability")
}

/// Phase 75 / Phase 3 prep — shopper loyalty points summary.
model ShopperLoyalty {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopperId            String    @unique @map("shopper_id") @db.Uuid
  shopper              Shopper   @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  pointsTotal          Int       @default(0) @map("points_total")
  /// Phase 76 — reciprocal action buckets.
  rsvpPoints           Int       @default(0) @map("rsvp_points")
  cateringPoints       Int       @default(0) @map("catering_points")
  collaborationPoints  Int       @default(0) @map("collaboration_points")
  boostedPoints        Int       @default(0) @map("boosted_points")
  lastActionDate       DateTime? @map("last_action_date") @db.Date
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([pointsTotal(sort: Desc)])
  @@map("shopper_loyalty")
}

/// Phase 76 — vendor-funded Double Point boost windows.
model VendorRewardsBoost {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId                   String   @map("vendor_id") @db.Uuid
  vendor                     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  label                      String   @default("DOUBLE_POINTS")
  multiplier                 Decimal  @default(2.00) @db.Decimal(4, 2)
  microFeeCentsPerBonusPoint Int      @default(1) @map("micro_fee_cents_per_bonus_point")
  startsAt                   DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt                     DateTime @map("ends_at") @db.Timestamptz(6)
  isActive                   Boolean  @default(true) @map("is_active")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  ledgerTicks                LoyaltyActionLedger[]

  @@index([vendorId, startsAt, endsAt])
  @@map("vendor_rewards_boost")
}

/// Phase 76 — append-only loyalty point ticks.
model LoyaltyActionLedger {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopperId     String   @map("shopper_id") @db.Uuid
  vendorId      String?  @map("vendor_id") @db.Uuid
  /// RSVP_MARKET_EVENT | CATERING_INQUIRY | COLLABORATION_PURCHASE | REDEMPTION
  actionType    String   @map("action_type")
  basePoints    Int      @map("base_points")
  bonusPoints   Int      @default(0) @map("bonus_points")
  pointsAwarded Int      @map("points_awarded")
  boostId       String?  @map("boost_id") @db.Uuid
  boost         VendorRewardsBoost? @relation(fields: [boostId], references: [id], onDelete: SetNull)
  referenceId   String?  @map("reference_id") @db.Uuid
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([shopperId, createdAt(sort: Desc)])
  @@index([vendorId, createdAt(sort: Desc)])
  @@map("loyalty_action_ledger")
}

/// Phase 76 — shopper redemptions at opted-in vendors.
model LoyaltyRedemption {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopperId   String   @map("shopper_id") @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  /// VOUCHER_5 | EARLY_ACCESS_CATERING
  tier        String
  pointsSpent Int      @map("points_spent")
  /// ACTIVE | USED | CANCELLED
  status      String   @default("ACTIVE")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([shopperId, createdAt(sort: Desc)])
  @@index([vendorId, createdAt(sort: Desc)])
  @@map("loyalty_redemptions")
}

/// Phase 78 — platform capital ledger (escrow / settlement).
model FinancialTransaction {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId        String?  @map("source_id") @db.Uuid
  destinationId   String?  @map("destination_id") @db.Uuid
  amountCents     Int      @map("amount_cents")
  voucherCents    Int      @default(0) @map("voucher_cents")
  netAmountCents  Int      @map("net_amount_cents")
  /// PENDING | HELD_IN_ESCROW | SETTLED | REFUNDED
  status          String   @default("PENDING")
  /// WHOLESALE | CATERING_DEPOSIT | LOYALTY_BOOST
  transactionType String   @map("transaction_type")
  referenceId     String?  @map("reference_id") @db.Uuid
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)])
  @@index([referenceId, transactionType])
  @@index([destinationId, createdAt(sort: Desc)])
  @@map("financial_transactions")
}

/// Phase 78 — vendor internal digital wallet.
model VendorBalance {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId              String   @unique @map("vendor_id") @db.Uuid
  vendor                Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  availableCents        Int      @default(0) @map("available_cents")
  escrowHeldCents       Int      @default(0) @map("escrow_held_cents")
  loyaltyLiabilityCents Int      @default(0) @map("loyalty_liability_cents")
  microFeeCents         Int      @default(0) @map("micro_fee_cents")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("vendor_balances")
}

/// Phase 11 peer engine statuses (PENDING | ACCEPTED | BLOCKED).
/// Distinct from profile-level vendor_connections (social) and phase54
/// vendor_business_connections (PENDING | ACCEPTED | DECLINED).
enum VendorPeerConnectionStatus {
  PENDING
  ACCEPTED
  BLOCKED

  @@map("vendor_peer_connection_status")
}

/// Phase 11 wholesale peer connection edge (requestor → recipient).
model VendorPeerConnection {
  id          String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestorId String                     @map("requestor_id") @db.Uuid
  requestor   Vendor                     @relation("PeerConnectionRequestor", fields: [requestorId], references: [id], onDelete: Cascade)
  recipientId String                     @map("recipient_id") @db.Uuid
  recipient   Vendor                     @relation("PeerConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      VendorPeerConnectionStatus @default(PENDING)
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([requestorId, recipientId])
  @@index([requestorId, status])
  @@index([recipientId, status])
  @@index([createdAt])
  @@map("vendor_peer_connections")
}

/// B2B wholesale partnership edge between directory Vendor rows (phase54).
/// Distinct from profile-level vendor_connections (social/network handshakes).
enum VendorBusinessConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED

  @@map("vendor_business_connection_status")
}

model VendorBusinessConnection {
  id               String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderVendorId   String                          @map("sender_vendor_id") @db.Uuid
  senderVendor     Vendor                          @relation("BusinessConnectionSender", fields: [senderVendorId], references: [id], onDelete: Cascade)
  receiverVendorId String                          @map("receiver_vendor_id") @db.Uuid
  receiverVendor   Vendor                          @relation("BusinessConnectionReceiver", fields: [receiverVendorId], references: [id], onDelete: Cascade)
  status           VendorBusinessConnectionStatus  @default(PENDING)
  initiatedAt      DateTime                        @default(now()) @map("initiated_at") @db.Timestamptz(6)
  updatedAt        DateTime                        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([senderVendorId, receiverVendorId])
  @@index([senderVendorId, status])
  @@index([receiverVendorId, status])
  @@index([initiatedAt])
  @@map("vendor_business_connections")
}

enum WholesaleProductStatus {
  ACTIVE
  ARCHIVED

  @@map("wholesale_product_status")
}

/// Bulk wholesale catalog SKU — distinct from consumer-facing Product rows.
model WholesaleProduct {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId        String                 @map("vendor_id") @db.Uuid
  vendor          Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  /// Packaging unit label (CASE, CRATE, BIN, LB, KG, EACH, ...).
  packagingUnit   String                 @map("packaging_unit")
  /// Fractional net weight per packaging unit (lbs).
  weightLbs       Decimal                @map("weight_lbs") @db.Decimal(12, 4)
  /// Minimum order quantity in packaging units.
  moq             Int
  /// Base unit price in cents for orders at MOQ.
  unitPriceCents  Int                    @map("unit_price_cents")
  /// Volume tiers: [{ "minQty": 10, "unitPriceCents": 1200 }, ...]
  pricingTiers    Json                   @default("[]") @map("pricing_tiers")
  freightNotes    String?                @map("freight_notes")
  pickupNotes     String?                @map("pickup_notes")
  /// Units available for wholesale reservation (phase57).
  availableQuantity Int                  @default(0) @map("available_quantity")
  /// Phase 65 — optional retail / consumer sale independent of wholesale MOQ.
  isRetailEnabled   Boolean              @default(false) @map("is_retail_enabled")
  /// Retail unit price in USD (decimal dollars); null until retail is configured.
  retailPrice       Decimal?             @map("retail_price") @db.Decimal(12, 4)
  status          WholesaleProductStatus @default(ACTIVE)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  orderItems      WholesaleOrderItem[]

  @@index([vendorId, status])
  @@index([vendorId, name])
  @@index([vendorId, isRetailEnabled])
  @@map("wholesale_products")
}

/// Draft → accept → ship → deliver statuses (phase56–59).
enum WholesaleOrderStatus {
  ORDER_DRAFT_INITIALIZED
  ORDER_ACCEPTED_BY_SELLER
  ORDER_REJECTED_BY_SELLER
  ORDER_SHIPPED_IN_TRANSIT
  ORDER_DELIVERY_CONFIRMED
  PAYMENT_SETTLED

  @@map("wholesale_order_status")
}

/// Multi-tenant B2B wholesale order draft header.
model WholesaleOrder {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerVendorId        String               @map("buyer_vendor_id") @db.Uuid
  buyerVendor          Vendor               @relation("WholesaleOrderBuyer", fields: [buyerVendorId], references: [id], onDelete: Cascade)
  sellerVendorId       String               @map("seller_vendor_id") @db.Uuid
  sellerVendor         Vendor               @relation("WholesaleOrderSeller", fields: [sellerVendorId], references: [id], onDelete: Cascade)
  status               WholesaleOrderStatus @default(ORDER_DRAFT_INITIALIZED)
  currency             String               @default("USD")
  subtotalCents        Int                  @map("subtotal_cents")
  /// Carrier label captured at fulfillment (phase58).
  carrierName          String?              @map("carrier_name")
  trackingNumber       String?              @map("tracking_number")
  estimatedDeliveryAt  DateTime?            @map("estimated_delivery_at") @db.Timestamptz(6)
  shippedAt            DateTime?            @map("shipped_at") @db.Timestamptz(6)
  /// Buyer-reported delivery timestamp (phase59).
  deliveredAt          DateTime?            @map("delivered_at") @db.Timestamptz(6)
  deliveryConfirmedAt  DateTime?            @map("delivery_confirmed_at") @db.Timestamptz(6)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items                WholesaleOrderItem[]
  settlementLog        WholesaleSettlementLog?
  invoice              WholesaleInvoice?

  @@index([buyerVendorId, status])
  @@index([sellerVendorId, status])
  @@index([createdAt])
  @@map("wholesale_orders")
}

/// Buyer delivery settlement ledger row (phase59).
model WholesaleSettlementLog {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String            @unique @map("order_id") @db.Uuid
  order          WholesaleOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerVendorId  String            @map("buyer_vendor_id") @db.Uuid
  sellerVendorId String            @map("seller_vendor_id") @db.Uuid
  subtotalCents  Int               @map("subtotal_cents")
  deliveredAt    DateTime          @map("delivered_at") @db.Timestamptz(6)
  settledAt      DateTime          @default(now()) @map("settled_at") @db.Timestamptz(6)
  invoice        WholesaleInvoice?

  @@index([buyerVendorId, settledAt])
  @@index([sellerVendorId, settledAt])
  @@map("wholesale_settlement_logs")
}

enum WholesaleInvoiceStatus {
  ISSUED
  PENDING
  OVERDUE
  PAID
  VOID

  @@map("wholesale_invoice_status")
}

/// Formal B2B invoice generated on delivery confirmation (phase60 / Net-30).
model WholesaleInvoice {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String                 @unique @map("order_id") @db.Uuid
  order              WholesaleOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  settlementLogId    String?                @unique @map("settlement_log_id") @db.Uuid
  settlementLog      WholesaleSettlementLog? @relation(fields: [settlementLogId], references: [id], onDelete: SetNull)
  invoiceNumber      String                 @unique @map("invoice_number")
  buyerVendorId      String                 @map("buyer_vendor_id") @db.Uuid
  sellerVendorId     String                 @map("seller_vendor_id") @db.Uuid
  buyerBusinessName  String?                @map("buyer_business_name")
  sellerBusinessName String?                @map("seller_business_name")
  currency           String                 @default("USD")
  subtotalCents      Int                    @map("subtotal_cents")
  totalCents         Int                    @map("total_cents")
  paymentTerms       String                 @default("NET_30") @map("payment_terms")
  /// Snapshot of line items: [{ productSkuId, quantity, unitPriceCents, lineTotalCents }]
  lineItems          Json                   @default("[]") @map("line_items")
  status             WholesaleInvoiceStatus @default(PENDING)
  issuedAt           DateTime               @default(now()) @map("issued_at") @db.Timestamptz(6)
  dueAt              DateTime               @map("due_at") @db.Timestamptz(6)
  /// Seller-confirmed payment clearance (phase61).
  paidAt             DateTime?              @map("paid_at") @db.Timestamptz(6)
  /// Stripe PaymentIntent created on delivery confirm (phase63).
  stripePaymentIntentId String?             @map("stripe_payment_intent_id")
  stripePaymentStatus   String?             @map("stripe_payment_status")
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([buyerVendorId, issuedAt])
  @@index([sellerVendorId, issuedAt])
  @@index([dueAt, status])
  @@map("wholesale_invoices")
}

model WholesaleOrderItem {
