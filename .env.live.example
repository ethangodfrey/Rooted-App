# =============================================================================
# Live stack smoke / remote resilience targets
# Copy values into your shell or `.env.live` (do not commit secrets).
# Canonical hosts: deploy/ingress.targets.json
# =============================================================================

# NestJS production health probe (Railway public proxy + api.vendorlymarketplace.app)
DEPLOY_HEALTH_URL=https://api.vendorlymarketplace.app/api/health
# Temporary Railway hostname only while DNS CNAME is pending:
# DEPLOY_HEALTH_URL=https://rooted-app-production-43fb.up.railway.app/api/health

# Next.js / tenant-web readiness gate (must not 404 after ingress deploy)
DEPLOY_READINESS_URL=https://tenant-web-psi.vercel.app/readiness
# Legacy alias still served: /api/health/readiness

# Optional live edge JSON route used ONLY when readiness is not yet deployed
DEPLOY_EDGE_FALLBACK_URL=https://tenant-web-psi.vercel.app/api/markets/nearby?latitude=39.7392&longitude=-104.9903

# Railway CLI restart during midpoint drain simulation
DEPLOY_RESTART_COMMAND=railway restart --service backend

# Live soak tuning — remote-only (no local Nest fallback loops)
DEPLOY_LIVE_STACK=1
DEPLOY_REQUIRE_HEALTH_OK=1
DEPLOY_DURATION_MS=20000
DEPLOY_CONCURRENCY=16
DEPLOY_BATCH_SIZE=80

# Disable local Nest boot so smoke fails closed when ingress is misaligned
LIVE_SMOKE_BOOT_LOCAL_NEST=0
LIVE_SMOKE_NEST_PORT=4010
