# =============================================================================
# Live stack smoke / remote resilience targets
# Copy values into your shell or `.env.live` (do not commit secrets).
# =============================================================================

# NestJS production health probe
DEPLOY_HEALTH_URL=https://api.vendorly.app/api/health
# Fallback Railway host (if custom domain DNS is not wired):
# DEPLOY_HEALTH_URL=https://rooted-app-production-43fb.up.railway.app/api/health

# Next.js / tenant-web readiness gate
DEPLOY_READINESS_URL=https://tenant-web-psi.vercel.app/api/health/readiness

# Optional live edge JSON route used when readiness is not yet deployed
DEPLOY_EDGE_FALLBACK_URL=https://tenant-web-psi.vercel.app/api/markets/nearby?latitude=39.7392&longitude=-104.9903

# Optional Railway CLI restart during midpoint drain simulation
# DEPLOY_RESTART_COMMAND=railway restart --service backend

# Live soak tuning
DEPLOY_LIVE_STACK=1
DEPLOY_REQUIRE_HEALTH_OK=1
DEPLOY_DURATION_MS=20000
DEPLOY_CONCURRENCY=16
DEPLOY_BATCH_SIZE=80

# When remote Nest is unreachable, live-stack-smoke can boot local Nest
# against live DATABASE_URL + SUPABASE_* for /api/health dependency checks.
LIVE_SMOKE_BOOT_LOCAL_NEST=1
LIVE_SMOKE_NEST_PORT=4010
